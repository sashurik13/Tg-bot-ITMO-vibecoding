# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=
# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# OpenAI API: ключ создаётся отдельно на platform.openai.com и хранится только в .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Модель поддерживает temperature, что требуется для эксперимента лабораторной.
OPENAI_MODEL=openrouter/free
OPENAI_TIMEOUT=30
OPENAI_MAX_OUTPUT_TOKENS=4096
# До 10 последних сообщений; суммарный бюджет content в символах.
HISTORY_LIMIT=10
HISTORY_CHAR_LIMIT=12000

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080

# Lab 2 read-only agent. false explicitly restores the Lab 1-only flow.
LAB2_ENABLED=true
# Only operator configuration selects the source; never a model/user argument.
LAB2_SCHEDULE_PATH=data/schedule.json
LAB2_SCHEDULE_TIMEZONE=Europe/Moscow
# Empty command uses the same Python executable as the bot (sys.executable).
# Arguments are a JSON array, not a shell command. Empty cwd uses the project root.
LAB2_MCP_COMMAND=
LAB2_MCP_ARGS='["-m", "app.mcp_server"]'
LAB2_MCP_CWD=
LAB2_MCP_TIMEOUT=10
LAB2_WEATHER_TIMEOUT=5
LAB2_WEATHER_READ_RETRIES=1
# Hard upper bounds: 2 calls/message and 300 seconds for confirmation.
LAB2_MAX_MCP_CALLS=2
# auto: native Responses functions, strict JSON fallback on explicit unsupported-tools error.
# structured: use strict JSON decisions for a provider without native tool support.
LAB2_LLM_TOOL_MODE=auto
LAB2_CONFIRMATION_TTL=300
# PostgreSQL tests use a separate temporary Docker DB with generated credentials.
# They do not read this file and need no production/test DSN in .env.
